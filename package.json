{
  "name": "vibe-cooking",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:check": "npm run build:worker && wrangler deploy --dry-run",
    "deploy": "node scripts/check-deploy.mjs && npm run build:worker && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "node --import tsx --experimental-sqlite --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/check-deploy.mjs && wrangler d1 migrations apply DB --remote",
    "db:export:remote": "wrangler d1 export DB --remote --output backups/kitchen.sql",
    "catalogue:import": "node --import tsx scripts/import-catalogue.ts",
    "token:create": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrations:check": "drizzle-kit check && node scripts/check-schema-drift.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@opennextjs/cloudflare": "1.20.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "iron-session": "8.0.4",
    "lucide-react": "^0.454.0",
    "next": "15.5.24",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.53.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "5.20260917.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "0.31.10",
    "postcss": "8.5.28",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "5.8.3",
    "wrangler": "4.134.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
